    timestamp,
    ticker,
    volume,
    LAST_VALUE(close IGNORE NULLS) OVER w_locf AS close,
    COALESCE(open, LAST_VALUE(close IGNORE NULLS) OVER w_locf) AS open,
    COALESCE(high, LAST_VALUE(close IGNORE NULLS) OVER w_locf) AS high,
