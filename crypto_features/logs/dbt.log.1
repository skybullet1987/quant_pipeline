    create or replace table `parnasa-498503`.`market_data`.`fct_4h_features_tbm`
      
    partition by timestamp_trunc(timestamp, day)
    cluster by ticker

    OPTIONS()
    as (
      

-- ============================================================================
-- STEP 1: Aggregate 1-Minute Bars into Native 4-Hour OHLCV Bars
-- ============================================================================
WITH raw_4h AS (
  SELECT
    TIMESTAMP_SECONDS(DIV(UNIX_SECONDS(timestamp), 14400) * 14400) AS timestamp,
    ticker,
    ARRAY_AGG(open ORDER BY timestamp ASC LIMIT 1)[OFFSET(0)] AS open,
    MAX(high) AS high,
    MIN(low) AS low,
    ARRAY_AGG(close ORDER BY timestamp DESC LIMIT 1)[OFFSET(0)] AS close,
    SUM(volume) AS volume
  FROM `parnasa-498503`.`market_data`.`stg_densified_ohlcv`
  GROUP BY 1, 2
),

-- ============================================================================
-- STEP 2: Compute Single-Bar Metrics (Returns, True Range, Garman-Klass Vol)
-- ============================================================================
bar_metrics AS (
  SELECT
    timestamp,
    ticker,
    open,
    high,
    low,
    close,
    volume,
    LOG(SAFE_DIVIDE(close, LAG(close, 1) OVER w_asset)) AS ret_4h,
    
    GREATEST(
      high - low,
      ABS(high - LAG(close, 1) OVER w_asset),
      ABS(low - LAG(close, 1) OVER w_asset)
    ) AS true_range,

    SQRT(
      0.5 * POW(LOG(SAFE_DIVIDE(high, low)), 2) 
      - (2 * LOG(2) - 1) * POW(LOG(SAFE_DIVIDE(close, open)), 2)
    ) AS gk_vol_bar
  FROM raw_4h
  WINDOW w_asset AS (PARTITION BY ticker ORDER BY timestamp)
),

-- ============================================================================
-- STEP 3: Rolling Feature Engineering (ATR, Vol Term Structure, Z-Scores)
-- ============================================================================
rolling_features AS (
  SELECT
    b.*,
    AVG(b.true_range) OVER w_20 AS atr_20,
    SQRT(AVG(POW(b.gk_vol_bar, 2)) OVER w_20) AS gk_vol_20p,
    SQRT(AVG(POW(b.gk_vol_bar, 2)) OVER w_120) AS gk_vol_120p,

    SAFE_DIVIDE(
      SQRT(AVG(POW(b.gk_vol_bar, 2)) OVER w_20),
      NULLIF(SQRT(AVG(POW(b.gk_vol_bar, 2)) OVER w_120), 0)
    ) AS vol_term_structure,

    SAFE_DIVIDE(
      SQRT(AVG(POW(b.gk_vol_bar, 2)) OVER w_20) - AVG(SQRT(AVG(POW(b.gk_vol_bar, 2)) OVER w_20)) OVER w_120,
      NULLIF(STDDEV(SQRT(AVG(POW(b.gk_vol_bar, 2)) OVER w_20)) OVER w_120, 0)
    ) AS gk_vol_zscore_120,

    SUM(IF(b.ticker = 'BTCUSD', b.ret_4h, 0)) OVER (PARTITION BY b.timestamp) AS btc_ret_4h
  FROM bar_metrics b
  WINDOW 
    w_20 AS (PARTITION BY b.ticker ORDER BY b.timestamp ROWS BETWEEN 19 PRECEDING AND CURRENT ROW),
    w_120 AS (PARTITION BY b.ticker ORDER BY b.timestamp ROWS BETWEEN 119 PRECEDING AND CURRENT ROW)
),

-- ============================================================================
-- STEP 4: Relative Alpha Momentum & Trend Alignment Features
-- ============================================================================
macro_metrics AS (
  SELECT
    rf.*,
    SUM(ret_4h - btc_ret_4h) OVER w_20 AS btc_beta_alpha_20p,
    SUM(ret_4h) OVER w_6 AS mom_24h,
    SUM(ret_4h) OVER w_42 AS mom_7d,
    
    SAFE_DIVIDE(ABS(close - open), NULLIF(high - low, 0)) AS candle_body_pct,
    SAFE_DIVIDE(high - GREATEST(open, close), NULLIF(high - low, 0)) AS candle_upper_wick_pct,
    SAFE_DIVIDE(LEAST(open, close) - low, NULLIF(high - low, 0)) AS candle_lower_wick_pct
  FROM rolling_features rf
  WINDOW
    w_6 AS (PARTITION BY rf.ticker ORDER BY rf.timestamp ROWS BETWEEN 5 PRECEDING AND CURRENT ROW),
    w_20 AS (PARTITION BY rf.ticker ORDER BY rf.timestamp ROWS BETWEEN 19 PRECEDING AND CURRENT ROW),
    w_42 AS (PARTITION BY rf.ticker ORDER BY rf.timestamp ROWS BETWEEN 41 PRECEDING AND CURRENT ROW)
),

-- ============================================================================
-- STEP 5: Triple Barrier Method (TBM) Dynamic Path Evaluation
-- ============================================================================
tbm_forward_window AS (
  SELECT
    m.*,
    m.close + (2.50 * m.atr_20) AS upper_barrier_price,
    m.close - (1.25 * m.atr_20) AS lower_barrier_price,
    
    ARRAY_AGG(
      STRUCT(
        high AS fwd_high,
        low AS fwd_low,
        close AS fwd_close
      )
    ) OVER (
      PARTITION BY m.ticker 
      ORDER BY m.timestamp 
      ROWS BETWEEN 1 FOLLOWING AND 18 FOLLOWING
    ) AS fwd_bars
  FROM macro_metrics m
),

tbm_path_resolution AS (
  SELECT
    f.*,
    (
      SELECT AS STRUCT
        MIN(IF(fwd.fwd_high >= f.upper_barrier_price, idx, NULL)) AS upper_hit_idx,
        MIN(IF(fwd.fwd_low <= f.lower_barrier_price, idx, NULL)) AS lower_hit_idx,
        ARRAY_AGG(fwd.fwd_close ORDER BY idx DESC LIMIT 1)[OFFSET(0)] AS vertical_exit_close,
        COUNT(1) AS fwd_bar_count
      FROM UNNEST(f.fwd_bars) WITH OFFSET idx
    ) AS barrier_res
  FROM tbm_forward_window f
),

tbm_labels AS (
  SELECT
    p.*,
    CASE
      WHEN p.barrier_res.fwd_bar_count < 18 THEN NULL 
      WHEN p.barrier_res.upper_hit_idx IS NOT NULL 
           AND (p.barrier_res.lower_hit_idx IS NULL OR p.barrier_res.upper_hit_idx < p.barrier_res.lower_hit_idx) 
           THEN 1
      ELSE 0
    END AS target_tbm_upper_hit,

    SAFE_DIVIDE(p.barrier_res.vertical_exit_close - p.close, p.close) AS ret_72h_vertical
  FROM tbm_path_resolution p
),

-- ============================================================================
-- STEP 6: Cross-Sectional Percentile Ranking Across Active Universe
-- ============================================================================
ranked_features AS (
  SELECT
    timestamp,
    ticker,
    open,
    high,
    low,
    close,
    volume,
    atr_20,
    upper_barrier_price,
    lower_barrier_price,
    target_tbm_upper_hit,
    ret_72h_vertical,
    
    EXTRACT(HOUR FROM timestamp) AS hour_of_day,
    EXTRACT(DAYOFWEEK FROM timestamp) AS day_of_week,
    IF(EXTRACT(DAYOFWEEK FROM timestamp) IN (1, 7), 1, 0) AS is_weekend,
    
    candle_body_pct,
    candle_upper_wick_pct,
    candle_lower_wick_pct,

    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY gk_vol_20p ASC) AS rank_gk_vol_20p,
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY vol_term_structure ASC) AS rank_vol_term_structure,
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY gk_vol_zscore_120 ASC) AS rank_gk_vol_zscore,
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY btc_beta_alpha_20p ASC) AS rank_btc_beta_alpha,
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY mom_24h ASC) AS rank_mom_24h,
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY mom_7d ASC) AS rank_mom_7d
  FROM tbm_labels
)

SELECT * 
FROM ranked_features 
WHERE timestamp IS NOT NULL 
  AND atr_20 IS NOT NULL
    );
  
