[0m17:17:00.043971 [debug] [Thread-3 (]: On model.crypto_features.fct_4h_features_tbm: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "crypto_features", "target_name": "prod", "node_id": "model.crypto_features.fct_4h_features_tbm"} */

  
    

    create or replace table `parnasa-498503`.`market_data`.`fct_4h_features_tbm`
      
    partition by timestamp_trunc(timestamp, day)
    cluster by ticker

    
    OPTIONS()
    as (
      

WITH timesfm_features AS (
    SELECT 
        ticker,
        -- Align target timestamp back to origin candle (T)
        TIMESTAMP_SUB(forecast_timestamp, INTERVAL 4 HOUR) AS timestamp,
        forecast_value,
        standard_error,
        prediction_interval_lower_bound AS lower_bound,
        prediction_interval_upper_bound AS upper_bound
    FROM `parnasa-498503.market_data.fct_timesfm_forecasts`
),

base_market AS (
    SELECT 
        *,
        -- Calculate True Range & 14-period ATR dynamically from OHLCV
        AVG(
            GREATEST(
                high - low,
                ABS(high - LAG(close, 1) OVER (PARTITION BY ticker ORDER BY timestamp)),
                ABS(low - LAG(close, 1) OVER (PARTITION BY ticker ORDER BY timestamp))
            )
        ) OVER (
            PARTITION BY ticker 
            ORDER BY timestamp 
            ROWS BETWEEN 13 PRECEDING AND CURRENT ROW
        ) AS atr_14
    FROM `parnasa-498503`.`market_data`.`stg_densified_ohlcv`
),

joined_signals AS (
    SELECT
        m.*,
        f.forecast_value,
        f.standard_error,
        f.lower_bound,
        f.upper_bound,
        
        -- 1. Directional Expected Return
        SAFE_DIVIDE(f.forecast_value - m.close, m.close) AS forecast_return,
        
        -- 2. Uncertainty & Dispersion
        (f.upper_bound - f.lower_bound) AS prediction_width,
        SAFE_DIVIDE(f.upper_bound - f.lower_bound, NULLIF(m.atr_14, 0)) AS width_to_atr,
        
        -- 3. Risk-Adjusted Conviction (Signal-to-Noise)
        SAFE_DIVIDE(SAFE_DIVIDE(f.forecast_value - m.close, m.close), NULLIF(f.standard_error, 0)) AS expected_sharpe_proxy,
        SAFE_DIVIDE(f.forecast_value - m.close, NULLIF(f.upper_bound - f.lower_bound, 0)) AS confidence_ratio

    FROM base_market m
    LEFT JOIN timesfm_features f
        ON m.ticker = f.ticker AND m.timestamp = f.timestamp
)

SELECT
    *,
    -- 4. Cross-Sectional Alpha Rank across 207 coins
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY forecast_return ASC) AS forecast_rank,
    
    -- 5. Signal Momentum Acceleration
    forecast_return - LAG(forecast_return, 1) OVER (PARTITION BY ticker ORDER BY timestamp) AS forecast_momentum,
    
    -- 6. Microstructure & Derivatives Interactions (coalesced safely if columns exist)
    forecast_return * COALESCE(ofi, 0) AS forecast_x_ofi,
    forecast_return * COALESCE(oi_change_4h, 0) AS forecast_x_oi,
    forecast_return * COALESCE(funding_rate, 0) AS forecast_x_funding,
    
    -- 7. Categorical Regime
    CAST(hmm_state AS STRING) AS hmm_regime_categorical
    
FROM joined_signals
    );
  
