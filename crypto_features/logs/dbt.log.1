    create or replace table `parnasa-498503`.`market_data`.`fct_4h_features_tbm`
      
    partition by timestamp_trunc(timestamp, day)
    cluster by ticker

    
    OPTIONS()
    as (
      

WITH timesfm_features AS (
    SELECT 
        ticker,
        TIMESTAMP_SUB(forecast_timestamp, INTERVAL 4 HOUR) AS timestamp,
        forecast_value,
        standard_error,
        prediction_interval_lower_bound AS lower_bound,
        prediction_interval_upper_bound AS upper_bound
    FROM `parnasa-498503.market_data.fct_timesfm_forecasts`
),

prev_close_data AS (
    SELECT 
        *,
        LAG(close, 1) OVER (PARTITION BY ticker ORDER BY timestamp) AS prev_close
    FROM `parnasa-498503`.`market_data`.`stg_densified_ohlcv`
),

tr_data AS (
    SELECT
        *,
        GREATEST(
            high - low,
            ABS(high - COALESCE(prev_close, close)),
            ABS(low - COALESCE(prev_close, close))
        ) AS true_range
    FROM prev_close_data
),

base_market AS (
    SELECT 
        *,
        AVG(true_range) OVER (
            PARTITION BY ticker 
            ORDER BY timestamp 
            ROWS BETWEEN 13 PRECEDING AND CURRENT ROW
        ) AS atr_14,

        MAX(high) OVER (
            PARTITION BY ticker 
            ORDER BY timestamp 
            ROWS BETWEEN 1 FOLLOWING AND 18 FOLLOWING
        ) AS fwd_max_high_18,

        MIN(low) OVER (
            PARTITION BY ticker 
            ORDER BY timestamp 
            ROWS BETWEEN 1 FOLLOWING AND 18 FOLLOWING
        ) AS fwd_min_low_18,

        LEAD(close, 18) OVER (
            PARTITION BY ticker 
            ORDER BY timestamp
        ) AS fwd_close_18
    FROM tr_data
),

joined_signals AS (
    SELECT
        m.*,
        f.forecast_value,
        f.standard_error,
        f.lower_bound,
        f.upper_bound,
        
        SAFE_DIVIDE(f.forecast_value - m.close, m.close) AS forecast_return,
        (f.upper_bound - f.lower_bound) AS prediction_width,
        SAFE_DIVIDE(f.upper_bound - f.lower_bound, NULLIF(m.atr_14, 0)) AS width_to_atr,
        SAFE_DIVIDE(SAFE_DIVIDE(f.forecast_value - m.close, m.close), NULLIF(f.standard_error, 0)) AS expected_sharpe_proxy,
        SAFE_DIVIDE(f.forecast_value - m.close, NULLIF(f.upper_bound - f.lower_bound, 0)) AS confidence_ratio,

        IF(m.fwd_max_high_18 >= m.close + (2.0 * m.atr_14), 1, 0) AS target_tbm_upper_hit,
        IF(m.fwd_min_low_18 <= m.close - (2.0 * m.atr_14), 1, 0) AS target_tbm_lower_hit,
        SAFE_DIVIDE(m.fwd_close_18 - m.close, m.close) AS target_return_72h,

        CASE 
          WHEN m.fwd_max_high_18 >= m.close + (2.0 * m.atr_14) AND m.fwd_min_low_18 > m.close - (2.0 * m.atr_14) THEN 1
          WHEN m.fwd_min_low_18 <= m.close - (2.0 * m.atr_14) AND m.fwd_max_high_18 < m.close + (2.0 * m.atr_14) THEN 0
          ELSE IF(m.fwd_close_18 > m.close, 1, 0)
        END AS target_tbm_label

    FROM base_market m
    LEFT JOIN timesfm_features f
        ON m.ticker = f.ticker AND m.timestamp = f.timestamp
)

SELECT
    *,
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY forecast_return ASC) AS forecast_rank,
    forecast_return - LAG(forecast_return, 1) OVER (PARTITION BY ticker ORDER BY timestamp) AS forecast_momentum
    
FROM joined_signals
    );
  
