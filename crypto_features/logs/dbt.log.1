    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY gk_vol_zscore_120 ASC) AS rank_gk_vol_zscore,
    PERCENT_RANK() OVER (PARTITION BY timestamp ORDER BY vol_compression_ratio ASC) AS rank_vol_compression_ratio,
