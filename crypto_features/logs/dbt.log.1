atr_data AS (
    SELECT *,
        AVG(_temp_true_range) OVER (PARTITION BY ticker ORDER BY timestamp ROWS BETWEEN 13 PRECEDING AND CURRENT ROW) AS _computed_atr_14
    FROM tr_data
),
joined AS (
    SELECT 
        orig.* EXCEPT(_temp_prev_close, _temp_true_range, _computed_atr_14),
        tf.forecast_value,
        tf.standard_error,
        tf.lower_bound,
        tf.upper_bound,
        SAFE_DIVIDE(tf.forecast_value - orig.close, orig.close) AS forecast_return,
        (tf.upper_bound - tf.lower_bound) AS prediction_width,
        SAFE_DIVIDE(tf.upper_bound - tf.lower_bound, NULLIF(orig._computed_atr_14, 0)) AS width_to_atr,
        SAFE_DIVIDE(SAFE_DIVIDE(tf.forecast_value - orig.close, orig.close), NULLIF(tf.standard_error, 0)) AS expected_sharpe_proxy,
        SAFE_DIVIDE(tf.forecast_value - orig.close, NULLIF(tf.upper_bound - tf.lower_bound, 0)) AS confidence_ratio
    FROM atr_data orig
    LEFT JOIN timesfm_features tf
        ON orig.ticker = tf.ticker AND orig.timestamp = tf.timestamp
)
SELECT 
