    when matched then update set
        `ticker` = DBT_INTERNAL_SOURCE.`ticker`,`timestamp` = DBT_INTERNAL_SOURCE.`timestamp`,`open` = DBT_INTERNAL_SOURCE.`open`,`high` = DBT_INTERNAL_SOURCE.`high`,`low` = DBT_INTERNAL_SOURCE.`low`,`close` = DBT_INTERNAL_SOURCE.`close`,`volume` = DBT_INTERNAL_SOURCE.`volume`,`prev_close` = DBT_INTERNAL_SOURCE.`prev_close`,`true_range` = DBT_INTERNAL_SOURCE.`true_range`,`atr_14` = DBT_INTERNAL_SOURCE.`atr_14`,`fwd_max_high_18` = DBT_INTERNAL_SOURCE.`fwd_max_high_18`,`fwd_min_low_18` = DBT_INTERNAL_SOURCE.`fwd_min_low_18`,`fwd_close_18` = DBT_INTERNAL_SOURCE.`fwd_close_18`,`forecast_value` = DBT_INTERNAL_SOURCE.`forecast_value`,`standard_error` = DBT_INTERNAL_SOURCE.`standard_error`,`lower_bound` = DBT_INTERNAL_SOURCE.`lower_bound`,`upper_bound` = DBT_INTERNAL_SOURCE.`upper_bound`,`forecast_return` = DBT_INTERNAL_SOURCE.`forecast_return`,`prediction_width` = DBT_INTERNAL_SOURCE.`prediction_width`,`width_to_atr` = DBT_INTERNAL_SOURCE.`width_to_atr`,`expected_sharpe_proxy` = DBT_INTERNAL_SOURCE.`expected_sharpe_proxy`,`confidence_ratio` = DBT_INTERNAL_SOURCE.`confidence_ratio`,`target_tbm_upper_hit` = DBT_INTERNAL_SOURCE.`target_tbm_upper_hit`,`target_tbm_lower_hit` = DBT_INTERNAL_SOURCE.`target_tbm_lower_hit`,`target_return_72h` = DBT_INTERNAL_SOURCE.`target_return_72h`,`target_tbm_label` = DBT_INTERNAL_SOURCE.`target_tbm_label`,`forecast_rank` = DBT_INTERNAL_SOURCE.`forecast_rank`,`forecast_momentum` = DBT_INTERNAL_SOURCE.`forecast_momentum`
    

    when not matched then insert
