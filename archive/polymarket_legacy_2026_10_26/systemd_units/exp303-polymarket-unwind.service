[Unit]
Description=EXP-303 Polymarket Fast-Unwind & Spread Capture Shadow Engine
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 /home/skybullet1987/quant_pipeline/src/polymarket_research/exp303_fast_unwind_shadow.py
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/polymarket/exp303_stdout.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/polymarket/exp303_error.log

[Install]
WantedBy=default.target
