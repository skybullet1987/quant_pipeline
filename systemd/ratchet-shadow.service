[Unit]
Description=Hyperliquid Isolated Liquidation Ratchet Shadow (EXP-201B)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 src/hl_leadlag/execution/hl_isolated_ratchet_shadow.py
Restart=on-failure
RestartSec=5s
KillMode=process
TimeoutStopSec=15s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/ratchet/ratchet_shadow.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/ratchet/ratchet_shadow.log

[Install]
WantedBy=default.target
