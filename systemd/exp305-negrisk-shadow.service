[Unit]
Description=EXP-305 NegRisk Combinatorial Basket Arbitrage Scanner & Valuation Engine
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 /home/skybullet1987/quant_pipeline/src/polymarket_research/negrisk_scanner.py --daemon --interval 30.0
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/negrisk/stdout.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/negrisk/error.log

[Install]
WantedBy=default.target
