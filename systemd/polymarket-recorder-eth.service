[Unit]
Description=Polymarket Continuous Orderbook Telemetry Recorder for ETH (Dual Feed 1H)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 src/polymarket_research/polymarket_terminal_recorder.py --asset ETH
Restart=on-failure
RestartSec=3
CPUWeight=1000
IOWeight=1000
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=15s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/polymarket/recorder_eth.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/polymarket/recorder_eth.log

[Install]
WantedBy=default.target
