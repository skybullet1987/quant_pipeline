[Unit]
Description=Polymarket Forward Paper Trader (v3.5 parity simulation)
After=network-online.target polymarket-recorder.service polymarket-recorder-eth.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 src/polymarket_research/polymarket_paper_trader.py
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=15s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/polymarket/paper_trader_stdout.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/polymarket/paper_trader_stdout.log

[Install]
WantedBy=default.target
