[Unit]
Description=EXP-202 Binance Trade-Tape De-Censoring Telemetry Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 /home/skybullet1987/quant_pipeline/src/hl_leadlag/market_data/exp202_trade_tape_detector.py
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/exp202/exp202_stdout.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/exp202/exp202_error.log

[Install]
WantedBy=default.target
