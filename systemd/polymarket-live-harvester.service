[Unit]
Description=Polymarket Live CLOB Real-Money Harvester (v5.4.0 BTC+ETH+SOL, Option B Z>=0.90 Ask<=$0.82 Taker-Only & $0.93 MFE Ratchet; config/polymarket_strategy_and_risk.json)
After=network-online.target polymarket-recorder.service polymarket-recorder-eth.service polymarket-recorder-sol.service
Wants=network-online.target polymarket-recorder.service
# Crash-loop protection: >5 non-zero crashes in 10 min => stay down.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
# Sizing / exposure / daily-loss / equity-floor come from config/polymarket_strategy_and_risk.json (v5.4.0 Option B Purged-WFO).
# --no-hold-to-maturity --exit-policy hold_98 activates Purged-WFO-winning single-tranche $0.98 Maker GTC TP + $0.93 High-Zone MFE 4c Ratchet,
# Option B (v5.4.0) enforces Z>=0.90, Ask<=$0.82 Taker-Only across [150s, 900s] 1h + [120s, 510s] 15m (while BOND1 Maker stays 100% live),
# and --allowed-assets BTC ETH SOL promotes BTC (1.0x) + ETH (0.85x canary) + SOL (0.85x canary) across 2->3->4 directional slots.
Environment="PM_ENFORCE_V5_TIER_SLOTS=1"
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python src/polymarket_research/polymarket_live_harvester.py --dynamic-sizing --no-hold-to-maturity --exit-policy hold_98 --max-concurrent 99 --max-ticket-cap 200.0 --max-trades-per-market 4 --max-trades-per-hour 60 --min-price-floor 0.52 --max-price-ceiling 0.82 --max-tte 2400.0 --allowed-assets BTC ETH SOL
# Exit 0 (circuit breaker / graceful SIGTERM) stays down; non-zero (crash) restarts after 3s.
Restart=on-failure
RestartSec=3
CPUWeight=1000
IOWeight=1000
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=20s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/polymarket/live_harvester_stdout.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/polymarket/live_harvester_stdout.log

[Install]
WantedBy=default.target
