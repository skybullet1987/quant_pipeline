[Unit]
Description=Polymarket Live CLOB Real-Money Harvester (v3.5; risk limits from config/polymarket_risk_config.json)
After=network-online.target polymarket-recorder.service polymarket-recorder-eth.service
Wants=network-online.target polymarket-recorder.service polymarket-recorder-eth.service
# Crash-loop protection (replaces the legacy bash supervisor): >5 failures in 10 min => stay down.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
# Sizing / exposure / daily-loss / equity-floor are NOT hardcoded here: they come from
# config/polymarket_risk_config.json (CLI flags would override them). No --reset-risk: an auto-restart
# must never silently clear a tripped circuit breaker (reload_production_daemons.py drops a one-shot marker instead).
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python src/polymarket_research/polymarket_live_harvester.py --dynamic-sizing --max-ticket-cap 200.0 --max-trades-per-market 2 --max-trades-per-hour 6 --min-price-floor 0.55 --max-price-ceiling 0.86 --max-tte 2700.0 --allowed-assets BTC ETH
# Exit 0 (circuit breaker / graceful SIGTERM) stays down; non-zero (crash) restarts after 3s.
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=20s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/polymarket/live_harvester_stdout.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/polymarket/live_harvester_stdout.log

[Install]
WantedBy=default.target
