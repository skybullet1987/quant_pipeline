# ==============================================================================
# DOMINUS STAGE G — READ-ONLY CROSS-VENUE SHADOW ENVIRONMENT TEMPLATE
# Target Production Path (when authorized): /etc/polymarket-shadow.env (chmod 0600)
#
# HARD SECURITY & COMPLIANCE RULES:
#   1. ZERO PRIVATE KEYS / ZERO SIGNING SECRETS: Never place wallet private keys,
#      mnemonics, POLY_SECRET, or Limitless HMAC trading secrets in this file.
#      `validate_shadow_env_file()` will hard-abort with exit code 78 if detected.
#   2. NEVER PASTE CREDENTIALS IN CHAT: Provision read-only keys strictly via
#      interactive non-echoing TTY (`getpass`) on an authorized host.
#   3. FAIL-CLOSED P0 GATE 0: `DOMINUS_NETWORK_MODE` defaults to `offline`.
#      Live venue polling (`live_public` / `live_authenticated`) requires an
#      explicitly attested non-restricted `DOMINUS_OPERATOR_JURISDICTION` (or
#      verified institutional `DOMINUS_KYB_AUTHORIZED_VENUES` + reference ID).
# ==============================================================================

PYTHONUNBUFFERED=1

# Network mode: "offline" | "live_public" | "live_authenticated"
DOMINUS_NETWORK_MODE=offline

# ISO-3166-1 / ISO-3166-2 operator jurisdiction at point of control (e.g. SE, FI, CH, CA-ON)
DOMINUS_OPERATOR_JURISDICTION=

# Execution host region code (e.g. LOCAL, FI, SE, CA-ON)
DOMINUS_SERVER_REGION=LOCAL

# Set to 1 if unproxied `GET https://polymarket.com/api/geoblock` on point of control returned blocked:true
DOMINUS_WORKSTATION_GEOBLOCKED=1

# Comma-separated enabled shadow venues (polymarket,predict_fun,sx_bet,limitless,forecastex,stx_ontario)
DOMINUS_ENABLED_VENUES=polymarket,predict_fun,sx_bet,limitless,forecastex,stx_ontario

# Optional institutional KYB allowlist override (only when written venue approval is held)
DOMINUS_KYB_AUTHORIZED_VENUES=
DOMINUS_KYB_REFERENCE_ID=

# Optional comma-separated SHA-256 hex digests of revoked keys to block accidental reuse
DOMINUS_REVOKED_KEY_SHA256_LIST=

# Optional read-only API keys & gateway endpoints (leave blank unless venue authorization is satisfied; NEVER commit values)
PREDICT_FUN_API_KEY=
PREDICT_FUN_ENV=mainnet
PREDICT_FUN_BUILDER_APP_ID=
PREDICT_FUN_DATA_LICENSE_ID=
SX_BET_API_KEY=
SX_BET_DATA_APPROVAL_ID=
SX_BET_WRITTEN_DATA_LICENSE_ID=
SX_BET_DATA_INQUIRY_ID=
POLYMARKET_INSTITUTIONAL_APP_ID=
LIMITLESS_INSTITUTIONAL_APP_ID=
IBKR_GATEWAY_URL=
IBKR_ALLOW_LOCALHOST_SELF_SIGNED=0
FORECASTEX_PUBLIC_PORTAL_AUTHORIZED=0
FORECASTEX_MAX_PUBLIC_CONTRACTS=600
STX_API_KEY_ID=
STX_ED25519_KEY_FILE=
STX_APPS_DATA_TOKEN=
STX_APPS_APPLICATION_ID=
STX_ENV=prod
STX_BASE_URL=
