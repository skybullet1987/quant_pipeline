[Unit]
Description=Polymarket Continuous Orderbook Telemetry Recorder for BNB (Dual Feed 1H + 15m)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 src/polymarket_research/polymarket_terminal_recorder.py --asset BNB
CPUWeight=50
IOWeight=50
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=15s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/polymarket/recorder_bnb.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/polymarket/recorder_bnb.log

[Install]
WantedBy=default.target
