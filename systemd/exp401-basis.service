[Unit]
Description=EXP-401 Cross-Venue Perpetual Basis & Horizon Carry Shadow Engine
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 /home/skybullet1987/quant_pipeline/src/research/exp401_perp_basis_shadow.py
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
