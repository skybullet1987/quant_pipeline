[Unit]
Description=HyperCore APEX Zero-Touch Mainnet Shadow Daemon (v5.2 Un-Overfit v5.0 + 4-Track Arena)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/home/skybullet1987/quant_pipeline/.env
# Low CPU/IO weight on 2-vCPU host so Polymarket real-money harvester & recorders always have top priority
CPUWeight=150
IOWeight=150
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python -u src/execution/production_apex_daemon.py --mainnet --dry-run --kernel-profile v5.0
Restart=always
RestartSec=15s
KillMode=process
TimeoutStopSec=30s
StandardOutput=append:/home/skybullet1987/quant_pipeline/execution_daemon.log
StandardError=append:/home/skybullet1987/quant_pipeline/execution_daemon.log

[Install]
WantedBy=default.target
