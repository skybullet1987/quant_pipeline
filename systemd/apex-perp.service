[Unit]
Description=HyperCore APEX Sovereign Perpetual Compounding Daemon (v5.1 Autonomous Profit Engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python -u src/execution/production_apex_daemon.py --mainnet-signals
Restart=always
RestartSec=15s
KillMode=process
TimeoutStopSec=30s
StandardOutput=append:/home/skybullet1987/quant_pipeline/execution_daemon.log
StandardError=append:/home/skybullet1987/quant_pipeline/execution_daemon.log

[Install]
WantedBy=default.target
