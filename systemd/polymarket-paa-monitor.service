[Unit]
Description=PAA Independent 1-Minute Operations, Accounting & Director Heartbeat Monitor
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/skybullet1987/quant_pipeline
Environment="PYTHONPATH=/home/skybullet1987/quant_pipeline"
Environment="PATH=/home/skybullet1987/.local/bin:/home/skybullet1987/quant_pipeline/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Nice=15
CPUWeight=50
IOWeight=50
MemoryMax=1024M
TimeoutStartSec=55
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python /home/skybullet1987/quant_pipeline/scripts/paa_cli.py monitor-cycle
