[Unit]
Description=Polymarket Consolidated Multi-Asset Orderbook Telemetry Recorder (BTC + ETH,SOL,XAU,XAG,XRP,BNB,DOGE,HYPE,ZEC Single uvloop)
After=network-online.target
Wants=network-online.target
Conflicts=polymarket-recorder-eth.service polymarket-recorder-sol.service polymarket-recorder-xrp.service polymarket-recorder-bnb.service polymarket-recorder-doge.service polymarket-recorder-hype.service

[Service]
Type=simple
WorkingDirectory=/home/skybullet1987/quant_pipeline
Environment=MALLOC_ARENA_MAX=2
ExecStart=/home/skybullet1987/quant_pipeline/venv/bin/python3 src/polymarket_research/polymarket_terminal_recorder.py --asset BTC --co-assets ETH,SOL,XAU,XAG,XRP,BNB,DOGE,HYPE,ZEC --riskless-bus-only
Restart=on-failure
RestartSec=3
CPUWeight=80
IOWeight=80
OOMScoreAdjust=-400
MemoryHigh=650M
MemoryMax=750M
MemorySwapMax=0
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=15s
StandardOutput=append:/home/skybullet1987/quant_pipeline/data/polymarket/recorder.log
StandardError=append:/home/skybullet1987/quant_pipeline/data/polymarket/recorder.log

[Install]
WantedBy=default.target
