def execute_trading_cycle():
    init_telemetry_db()
    if os.path.exists(HALT_LOCKFILE) or os.path.exists(DRAWDOWN_LOCKFILE):
        logging.critical("[HALT] Lockfile active. Aborting trading cycle.")
        return

    pk = os.getenv("HYPERLIQUID_PRIVATE_KEY")
    addr = os.getenv("HYPERLIQUID_MASTER_ADDRESS")
    if not pk or not addr:
        logging.critical("Missing credentials in .env")
        return

    acct = Account.from_key(pk)
    info = Info(API_URL, skip_ws=True)
    exchange = Exchange(acct, API_URL, account_address=addr)

    manage_existing_positions(info, exchange, addr)

    equity, margin_used, peak_eq, dd, dd_mult, user_state = get_unified_account_state(info, addr)
    logging.info("=" * 85)
    logging.info(f"HIGH-OCTANE DAEMON | Equity: ${equity:,.2f} | Peak: ${peak_eq:,.2f} | DD: -{dd*100:.2f}% | Multiplier: {dd_mult:.2f}x")
    logging.info(f"Margin In Use: ${margin_used:,.2f} / ${equity * MAX_TOTAL_MARGIN_UTILIZATION:,.2f} (Max Cap: 85%)")
    logging.info("=" * 85)

    if dd_mult == 0.0:
        logging.critical("[HALT] Trading halted due to 30% drawdown breaker.")
        return

    active_pos = user_state.get("assetPositions", [])
    open_syms = {p["position"]["coin"] for p in active_pos if float(p["position"]["szi"]) != 0}
    available_slots = MAX_POSITIONS - len(open_syms)

    if available_slots <= 0:
        logging.info(f"[SLOT CAP] Maximum positions active ({len(open_syms)}/{MAX_POSITIONS}). Skipping entry.")
        return

    df_scores = fetch_latest_model_scores()
    if df_scores.empty:
        logging.info("No fresh scoring rows returned from BigQuery.")
        return

    try:
        live_mids = info.all_mids()
    except Exception as e:
        logging.error(f"Failed to fetch live mids: {e}")
        return

    meta = info.meta()
    sz_decimals_map = {asset["name"]: asset["szDecimals"] for asset in meta.get("universe", [])}
    max_lev_map = {asset["name"]: asset["maxLeverage"] for asset in meta.get("universe", [])}

    candidate_evals = []
    eligible_candidates = []

    # ------------------------------------------------------------------------
    # PASS 1: CANDIDATE FILTERING & NET EV EVALUATION
    # ------------------------------------------------------------------------
    for _, row in df_scores.iterrows():
        coin = str(row["ticker"]).replace("USDT", "").replace("USD", "").upper()
        pl, ps, pc = float(row.get("p_long", 0.0)), float(row.get("p_short", 0.0)), float(row.get("p_chop", 0.0))
        reg = str(row.get("regime", "1"))
        signal_px = float(row.get("close_price", row.get("close", 0.0)))
        atr = float(row.get("atr_14", row.get("atr_20", signal_px * 0.02)))

        live_px = float(live_mids.get(coin, signal_px))
        if live_px <= 0 or atr <= 0:
            continue

        l_pass = (pl >= ENTRY_THRESHOLD_LONG and reg != "2")
        s_pass = (ps >= ENTRY_THRESHOLD_SHORT and reg != "1")
        chop_pass = (pc < 0.50)

        # 1.5x ATR TP / 1.5x ATR SL
        r_dist = (1.50 * atr) / live_px
        fee_cut = FEE_SLIPPAGE_BPS / 10000.0

        long_ev = (((2.0 * pl) - 1.0) * r_dist) - fee_cut
        short_ev = (((2.0 * ps) - 1.0) * r_dist) - fee_cut

        rec = {
            "coin": coin, "p_l": pl, "p_s": ps, "p_c": pc, "regime": reg,
            "max_p": max(pl, ps), "status": "REJECTED", "reason_code": "NONE",
            "reason": "", "ev_bps": 0.0
        }

        if coin not in sz_decimals_map:
            rec["reason_code"] = "UNIVERSE_EXCLUDED"
            rec["reason"] = "Asset not in Hyperliquid universe"
        elif coin in open_syms:
            rec["reason_code"] = "POSITION_EXISTS"
            rec["reason"] = "Active position already open"
        elif not l_pass and not s_pass:
            rec["reason_code"] = "PROBABILITY_FAIL"
            rec["reason"] = f"Probability below hurdle (L:{pl:.2f}, S:{ps:.2f})"
        elif not chop_pass:
            rec["reason_code"] = "CHOP_FAIL"
            rec["reason"] = f"Chop filter active (p_chop: {pc:.2f} >= 0.50)"
        elif pl >= ENTRY_THRESHOLD_LONG and reg == "2":
            rec["reason_code"] = "REGIME_CASCADE_BLOCK"
            rec["reason"] = "Long blocked in Cascade regime (R2)"
        elif ps >= ENTRY_THRESHOLD_SHORT and reg == "1":
            rec["reason_code"] = "REGIME_TREND_BLOCK"
            rec["reason"] = "Short blocked in Bull Trend regime (R1)"
        else:
            is_buy = l_pass and (not s_pass or pl >= ps)
            side, p_win, ev_val = ("BUY", pl, long_ev) if is_buy else ("SELL", ps, short_ev)
            k_frac = KELLY_FRACTION_LONG if is_buy else KELLY_FRACTION_SHORT
            base_lev = LEVERAGE_LONG if is_buy else LEVERAGE_SHORT
            rec["ev_bps"] = ev_val * 10000.0

            if ev_val <= 0:
                rec["reason_code"] = "NEGATIVE_EV"
                rec["reason"] = f"Negative Net EV ({rec['ev_bps']:+.1f} bps)"
            else:
                rec["status"] = "ELIGIBLE"
                rec["reason_code"] = "PASSED_GATES"
                rec["reason"] = f"Passed all gates ({side} {rec['ev_bps']:+.1f} bps)"
                eligible_candidates.append({
                    "coin": coin, "is_buy": is_buy, "side": side, "ev": ev_val,
                    "ev_bps": rec["ev_bps"], "p_win": p_win, "k_frac": k_frac,
                    "base_lev": base_lev, "signal_px": signal_px, "live_px": live_px,
                    "atr": atr, "r_dist": r_dist
                })

        candidate_evals.append(rec)

    # Persist Rejection Waterfall to SQLite
    now_ts = datetime.now(timezone.utc).isoformat()
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    for ce in candidate_evals:
        c.execute("""
            INSERT INTO candidate_evaluations 
            (timestamp, symbol, p_long, p_short, p_chop, regime, ev_bps, status, reason_code, reason)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (now_ts, ce["coin"], ce["p_l"], ce["p_s"], ce["p_c"], ce["regime"], ce["ev_bps"], ce["status"], ce["reason_code"], ce["reason"]))
    conn.commit()
    conn.close()

    logging.info("=== CANDIDATE EVALUATION WATERFALL (TOP 8) ===")
    for ce in sorted(candidate_evals, key=lambda x: x["max_p"], reverse=True)[:8]:
        logging.info(f"{ce['coin']:<8} | L:{ce['p_l']:.2f}/S:{ce['p_s']:.2f} | Chop:{ce['p_c']:.2f} | R:{ce['regime']} | EV:{ce['ev_bps']:>+6.1f} bps | [{ce['reason_code']}] {ce['reason']}")

    if not eligible_candidates:
        logging.info("[CYCLE COMPLETE] No candidate passed alpha and regime gates.")
        return

    # ------------------------------------------------------------------------
    # PASS 2: GLOBAL EV RANKING & HIGH-OCTANE KELLY ALLOCATION
    # ------------------------------------------------------------------------
    ranked_candidates = sorted(eligible_candidates, key=lambda x: x["ev"], reverse=True)
    max_executions = min(MAX_TRADES_PER_CYCLE, available_slots)
    approved_orders = []

    available_margin_pool = max(0.0, (equity * MAX_TOTAL_MARGIN_UTILIZATION) - margin_used)

    for cand in ranked_candidates:
        if len(approved_orders) >= max_executions:
            break

        coin = cand["coin"]
        live_px = cand["live_px"]
        p_win = cand["p_win"]
        k_frac = cand["k_frac"]
        is_buy = cand["is_buy"]

        kelly_f = p_win - ((1.0 - p_win) / 1.0)
        coin_max_lev = float(max_lev_map.get(coin, cand["base_lev"]))
        applied_lev = min(coin_max_lev, cand["base_lev"])

        trade_notional_pct = min(kelly_f * k_frac * applied_lev * dd_mult, 2.0)
        ideal_notional = equity * trade_notional_pct

        max_margin_notional = available_margin_pool * applied_lev
        target_notional = min(ideal_notional, max_margin_notional, HARD_LIQUIDITY_CAP_USD)
        required_margin = target_notional / applied_lev

        if required_margin > available_margin_pool or target_notional < 10.0:
            logging.info(f"[MARGIN CAP] {coin} rejected (Requires ${required_margin:.2f}, Avail: ${available_margin_pool:.2f})")
            continue

        sz_dec = sz_decimals_map.get(coin, 2)
        raw_sz = target_notional / live_px
        sz = int(round(raw_sz)) if sz_dec == 0 else round(raw_sz, sz_dec)

        if sz <= 0:
            logging.warning(f"[PRECISION] {coin} size rounded to zero at notional ${target_notional:.2f}")
            continue

        tp_px = format_hl_price(live_px + (1.50 * cand["atr"]) if is_buy else live_px - (1.50 * cand["atr"]), sz_dec)
        sl_px = format_hl_price(live_px - (1.50 * cand["atr"]) if is_buy else live_px + (1.50 * cand["atr"]), sz_dec)

        approved_orders.append({
            "coin": coin, "is_buy": is_buy, "side": cand["side"], "ev_bps": cand["ev_bps"],
            "notional": target_notional, "margin": required_margin, "sz": sz, "sz_dec": sz_dec,
            "lev": applied_lev, "signal_px": cand["signal_px"], "ref_px": live_px,
            "tp_px": tp_px, "sl_px": sl_px
        })
        available_margin_pool -= required_margin

    # ------------------------------------------------------------------------
    # PASS 3: ON-CHAIN EXECUTION & FAIL-SAFE BRACKETING
    # ------------------------------------------------------------------------
    for o in approved_orders:
        coin = o["coin"]
        logging.info(f"[ORDER ROUTE] {o['side']} {o['sz']} {coin} @ Ref ${o['ref_px']:.4f} | TP: ${o['tp_px']} | SL: ${o['sl_px']} (Notional: ${o['notional']:,.2f} | Lev: {o['lev']}x)")

        if DRY_RUN:
            continue

        try:
            exchange.update_leverage(int(o["lev"]), coin)
            entry_res = exchange.market_open(coin, o["is_buy"], o["sz"], o["ref_px"], 0.01)
            logging.info(f"[ENTRY RESPONSE] {coin} -> {entry_res}")

            if entry_res.get("status") != "ok":
                logging.error(f"[EXECUTION REJECTED] {coin} entry failed: {entry_res}")
                continue

            actual_sz = 0.0
            fill_px = o["ref_px"]
            try:
                statuses = entry_res.get("response", {}).get("data", {}).get("statuses", [])
                if statuses and "filled" in statuses[0]:
                    actual_sz = float(statuses[0]["filled"]["totalSz"])
                    fill_px = float(statuses[0]["filled"]["avgPx"])
            except Exception:
                pass

            if actual_sz <= 0:
                logging.warning(f"[FILL VERIFICATION] Querying on-chain state for {coin}...")
                verified_state = info.user_state(addr)
                for p in verified_state.get("assetPositions", []):
                    if p["position"]["coin"] == coin:
                        actual_sz = abs(float(p["position"]["szi"]))
                        fill_px = float(p["position"]["entryPx"])
                        break

            if actual_sz <= 0:
                logging.critical(f"[FAIL-SAFE TRIGGERED] Could not confirm position on {coin}. Brackets aborted.")
                continue

            tp_res = exchange.order(
                coin, not o["is_buy"], actual_sz, o["tp_px"],
                {"trigger": {"isMarket": True, "triggerPx": o["tp_px"], "tpsl": "tp"}},
                reduce_only=True
            )
            logging.info(f"[TP BRACKET] {coin} ({actual_sz}) -> {tp_res}")

            sl_res = exchange.order(
                coin, not o["is_buy"], actual_sz, o["sl_px"],
                {"trigger": {"isMarket": True, "triggerPx": o["sl_px"], "tpsl": "sl"}},
                reduce_only=True
            )
            logging.info(f"[SL BRACKET] {coin} ({actual_sz}) -> {sl_res}")

            slippage_bps = ((fill_px - o["ref_px"]) / o["ref_px"] * 10000.0) if o["is_buy"] else ((o["ref_px"] - fill_px) / o["ref_px"] * 10000.0)

            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            c.execute("""
                INSERT INTO execution_telemetry 
                (timestamp, symbol, order_side, status, size_notional, size_tokens, signal_px, ref_px, fill_px, slippage_bps, tp_px, sl_px, margin_used, entry_time)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                datetime.now(timezone.utc).isoformat(), coin, o["side"], "FILLED_WITH_BRACKET",
                o["notional"], actual_sz, o["signal_px"], o["ref_px"], fill_px, slippage_bps,
                o["tp_px"], o["sl_px"], o["margin"], datetime.now(timezone.utc).isoformat()
            ))
            conn.commit()
            conn.close()

        except Exception as e:
            logging.error(f"[EXECUTION ERROR] {coin}: {e}")


if __name__ == "__main__":
    execute_trading_cycle()
