def calculate_drawdown_multiplier(drawdown: float) -> float:
    if drawdown >= 0.30:
        return 0.0
    elif drawdown >= 0.25:
        return 0.10
    elif drawdown >= 0.20:
        return 0.25
    elif drawdown >= 0.15:
        return 0.50
    elif drawdown >= 0.10:
        return 0.75
    return 1.00


def get_unified_account_state(info: Info, address: str):
    user_state = info.user_state(address)
    spot_state = info.spot_user_state(address)

    margin_summary = user_state.get("marginSummary", {})
    perp_equity = float(margin_summary.get("accountValue", 0.0))
    margin_used = float(margin_summary.get("totalMarginUsed", 0.0))

    spot_usdc = sum(float(b.get("total", 0.0)) for b in spot_state.get("balances", []) if b.get("coin") == "USDC")
    total_equity = perp_equity + spot_usdc

    peak_equity = total_equity
    if os.path.exists(PEAK_EQUITY_FILE):
        try:
            with open(PEAK_EQUITY_FILE, "r") as f:
                peak_equity = max(float(f.read().strip()), total_equity)
        except Exception:
            peak_equity = total_equity

    with open(PEAK_EQUITY_FILE, "w") as f:
        f.write(str(peak_equity))

    drawdown = (peak_equity - total_equity) / peak_equity if peak_equity > 0 else 0.0
    dd_mult = calculate_drawdown_multiplier(drawdown)

    if dd_mult == 0.0:
        logging.critical(f"[CIRCUIT BREAKER] Max Drawdown breached ({drawdown*100:.2f}% >= 30%). Tripping lockfile.")
        with open(DRAWDOWN_LOCKFILE, "w") as f:
            f.write(f"Halted at {datetime.now(timezone.utc).isoformat()} due to {drawdown*100:.2f}% drawdown.")

    return total_equity, margin_used, peak_equity, drawdown, dd_mult, user_state


def manage_existing_positions(info: Info, exchange: Exchange, address: str):
    user_state = info.user_state(address)
    active_positions = [p["position"] for p in user_state.get("assetPositions", []) if float(p["position"]["szi"]) != 0]
    if not active_positions:
        return

    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    now = datetime.now(timezone.utc)

    for p in active_positions:
        coin = p["coin"]
        c.execute("""
            SELECT entry_time FROM execution_telemetry 
            WHERE symbol = ? AND status IN ('FILLED', 'FILLED_WITH_BRACKET')
            ORDER BY timestamp DESC LIMIT 1
        """, (coin,))
        row = c.fetchone()

        if row:
            try:
                entry_dt = datetime.fromisoformat(row[0])
                if entry_dt.tzinfo is None:
                    entry_dt = entry_dt.replace(tzinfo=timezone.utc)
                age_hours = (now - entry_dt).total_seconds() / 3600.0

                if age_hours >= MAX_HOLD_HOURS:
                    logging.info(f"[TIMEOUT CLOSE] {coin} held for {age_hours:.1f}h (limit {MAX_HOLD_HOURS}h). Market closing...")
                    if not DRY_RUN:
                        for o in info.open_orders(address):
                            if o["coin"] == coin:
                                exchange.cancel(coin, o["oid"])
                        exchange.market_close(coin)
                        c.execute("""
                            INSERT INTO execution_telemetry 
                            (timestamp, symbol, order_side, status, size_notional, size_tokens, signal_px, ref_px, fill_px, slippage_bps, tp_px, sl_px, margin_used, entry_time)
                            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, (now.isoformat(), coin, "CLOSE_TIMEOUT", "CLOSED", 0, 0, 0, 0, 0, 0, 0, 0, 0, now.isoformat()))
                        conn.commit()
            except Exception as e:
                logging.warning(f"Error managing timeout for {coin}: {e}")
    conn.close()

