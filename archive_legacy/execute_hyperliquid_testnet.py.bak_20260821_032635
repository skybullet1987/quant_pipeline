def format_hl_price(px: float, sz_decimals: int) -> float:
    if px == 0 or px is None or math.isnan(px):
        return 0.0
    max_price_decimals = max(0, 6 - sz_decimals)
    formatted = float(f"{px:.5g}")
    return round(formatted, max_price_decimals)


def init_telemetry_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # Auto-migrate legacy execution_telemetry table if column layout is old
    c.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='execution_telemetry'")
    if c.fetchone():
        c.execute("PRAGMA table_info(execution_telemetry)")
        cols = [r[1] for r in c.fetchall()]
        if "size_tokens" not in cols:
            logging.info("[DB MIGRATION] Migrating legacy execution_telemetry schema...")
            c.execute("ALTER TABLE execution_telemetry RENAME TO execution_telemetry_old")

    c.execute("""
        CREATE TABLE IF NOT EXISTS execution_telemetry (
            timestamp TEXT,
            symbol TEXT,
            order_side TEXT,
            status TEXT,
            size_notional REAL,
            size_tokens REAL,
            signal_px REAL,
            ref_px REAL,
            fill_px REAL,
            slippage_bps REAL,
            tp_px REAL,
            sl_px REAL,
            margin_used REAL,
            entry_time TEXT
        )
    """)

    # Auto-migrate candidate_evaluations table
    c.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='candidate_evaluations'")
    if c.fetchone():
        c.execute("PRAGMA table_info(candidate_evaluations)")
        cols = [r[1] for r in c.fetchall()]
        if "reason_code" not in cols:
            logging.info("[DB MIGRATION] Migrating legacy candidate_evaluations schema...")
            c.execute("ALTER TABLE candidate_evaluations RENAME TO candidate_evaluations_old")

    c.execute("""
        CREATE TABLE IF NOT EXISTS candidate_evaluations (
            timestamp TEXT,
            symbol TEXT,
            p_long REAL,
            p_short REAL,
            p_chop REAL,
            regime TEXT,
            ev_bps REAL,
            status TEXT,
            reason_code TEXT,
            reason TEXT
        )
    """)
    conn.commit()
    conn.close()


def get_active_model_dir() -> str:
    manifest_path = "models/manifest.json"
    if os.path.exists(manifest_path):
        try:
            with open(manifest_path, "r") as f:
                data = json.load(f)
                active_ver = data.get("active_version", "v2026_08_01")
                release_dir = os.path.join("models", "releases", active_ver)
                if os.path.exists(release_dir):
                    return release_dir
        except Exception:
            pass
    return "production_models" if os.path.exists("production_models") else "."

PROD_MODELS_DIR = get_active_model_dir()

